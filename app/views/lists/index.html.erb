<div class="banner" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url(https://salles-cinema.com/wp-content/uploads/2024/07/pathe-palace-opera.jpg);">
  <div class="container text-center">
    <h1>Save any kind of movies</h1>
    <p>Classic</p>
  </div>
</div>

<div class="container mt-3">
    <h2>My lists</h2>
    <div class="cards">
      <% @lists.each do |list| %>
        <%= link_to list_path(list) do  %>
          <div class="card-category" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url(<%= list.image_url %>)">
            <p><%= list.name %></p>
          </div>
        <% end %>
      <% end %>
  </div>

  <div class="goto mt-3">
    <%= link_to "Create new list", new_list_path  %>
  </div>

</div>
